// Prisma schema for the DQ Dental CAD server.
// Kept portable to PostgreSQL: no SQLite-only features (no @db.* SQLite-specific
// attributes, no raw SQL, id defaults are generated client-side via Prisma's
// `uuid()` function rather than a SQLite-only expression).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id            String   @id @default(uuid())
  name          String
  schemaVersion Int
  documentJson  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Phase 7 Task 4 — one row per successful export RELEASE (the server's
// independent re-validation passed on the exact exported bytes). Rows are an
// append-only release ledger: re-exporting byte-identical content creates a
// NEW row (a distinct release event with its own `releasedAt`) that points at
// the SAME content-addressed stored object (`bytesSha256` — the mesh-storage
// idempotency). Row growth is deliberately UNBOUNDED (review N3,
// documented-by-design): every release event — including byte-identical
// replays — is an auditable row; no dedup/rate bound is applied here. If
// support ever doesn't need every replay event, a retention policy belongs in
// an ops job, not in the release path. `releasedAt` is a RECORD field only
// (audit display): it is a
// server timestamp that never participates in any hashed content
// (export-determinism global constraint). JSON columns are portable SQL
// (plain TEXT), same convention as `Case.documentJson`.
model Export {
  id                  String   @id @default(uuid())
  caseId              String
  restorationId       String
  restorationType     String
  /// JSON array of FDI tooth numbers (e.g. "[14,15,16]").
  teethJson           String
  format              String
  /// SHA-256 (lowercase hex) of the released bytes — the content address of
  /// the stored object AND the download route's `:hash` parameter.
  bytesSha256         String
  byteLength          Int
  /// Canonical content hash of the f64 source solid (`stages.finalMesh`).
  meshContentHash     String
  /// Canonical content hash of the RE-IMPORTED byte-derived solid the server
  /// QC actually measured (differs from `meshContentHash` by the documented
  /// canonical re-index + f32 narrowing — see export-route.ts).
  reimportMeshHash    String
  /// Phase 7 Task 5 — the journaled STL header text (header-verified at
  /// release; null for PLY and for pre-Task-5 rows). Recorded so the
  /// traceability document is REGENERABLE from the ledger row alone
  /// (export-traceability.ts).
  headerText          String?
  exportOperationId   String
  caseJournalHash     String
  /// Phase 7 Task 5 — operations hashed into `caseJournalHash` (the request
  /// binding); null only on pre-Task-5 rows (regeneration refuses those).
  journalOperationCount Int?
  kernelVersion       String
  profileId           String
  profileVersion      String
  profileChecksum     String
  /// The SERVER-recomputed QcReport (the authoritative copy), JSON.
  qcReportJson        String
  /// The journal-verified acknowledgments riding into this release, JSON.
  acknowledgmentsJson String
  /// Phase 7 Task 5 — the CANONICAL (sorted-keys, whitespace-free) QC
  /// traceability document JSON, generated at release time from the
  /// SERVER's re-validation results, schema-validated before storage, and
  /// served VERBATIM by GET /api/exports/:id/traceability.json (byte-
  /// pinnable: the document carries ZERO timestamps — `releasedAt` below is
  /// the only release-time record, and it never enters this document).
  /// Null only on pre-Task-5 rows (the routes 404 typed for those).
  traceabilityJson    String?
  /// Phase 7 Task 6 (Part B, review F-B1) — provenance of THIS ledger row.
  /// `true` iff the row was reconstructed from an imported case archive rather
  /// than written by the server's own dual-validation release path. An archive
  /// is client-supplied + unsigned: its manifest gives INTEGRITY, not
  /// AUTHENTICITY, and imported release rows (qcReportJson/traceabilityJson/
  /// acknowledgments) are attested by the archive author, NOT re-validated here
  /// (the qcContext riding surfaces needed to re-run QC are not carried in the
  /// ledger/archive). This flag keeps the ledger honest so a consumer never
  /// mistakes an imported release for a server-re-validated one. `null` on
  /// rows predating this column (all genuinely server-verified). Never enters
  /// any hashed content.
  importedUnverified  Boolean?
  /// H1 fix (server code-review) — the QC gates whose MEASURED value the server
  /// did NOT recompute at release: their design-time inputs (connector
  /// frame/profiles, pontic↔gingiva relation, contact morph residuals) are not
  /// carried in the exported mill bytes nor the release request, so the server
  /// re-validation consumed the CLIENT-ATTESTED scalar rather than re-measuring
  /// it (invariant 6 stays literal: the solid-consuming gates are recomputed on
  /// the re-imported bytes; these specific gates are marked attested, never
  /// presented as a full-authority server-verified pass). JSON array of gate
  /// names (e.g. "[\"connectorCrossSection\",\"ponticRelief\"]"); `null` on rows
  /// predating this column. Mirrors the `importedUnverified` provenance pattern.
  /// Never enters any hashed content.
  attestedGatesJson   String?
  releasedAt          DateTime @default(now())

  @@index([bytesSha256])
  @@index([caseId])
}

// Phase 7 Task 4 — the persisted client/server-mismatch diagnostic bundle
// (the bug-report payload): both reports, the per-field diff, byte hashes,
// kernel/profile versions, and parse+intake diagnostics ride in `bundleJson`.
// Persisted server-side for support triage; the row id is returned in the
// 409 response.
model ExportDiagnostic {
  id            String   @id @default(uuid())
  caseId        String
  restorationId String
  /// Closed reason set — see export-route.ts (`qc-mismatch` today).
  reason        String
  bytesSha256   String
  bundleJson    String
  createdAt     DateTime @default(now())

  @@index([caseId])
}
