# Git LFS: binary mesh fixtures. Covers both the synthetic golden fixtures
# generated by scripts/generate-fixtures.ts and the real (anonymized) scan
# fixtures Task 8 adds under test-fixtures/real-scans/ — both patterns are
# in place up front so Task 8 doesn't need to touch this file.
test-fixtures/**/*.stl filter=lfs diff=lfs merge=lfs -text
test-fixtures/**/*.ply filter=lfs diff=lfs merge=lfs -text
